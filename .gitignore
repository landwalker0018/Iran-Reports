# Ignore everything by default.
*

# Keep directories traversable so allow-list rules below can match nested files.
!*/

# Keep Git ignore rules.
!.gitignore

# Plain text and documentation.
!*.txt
!*.md
!*.markdown
!*.rst
!*.adoc
!*.csv
!*.tsv
!*.log
!README
!README.*
!LICENSE
!LICENSE.*
!CHANGELOG
!CHANGELOG.*
!NOTICE
!NOTICE.*

# Configuration and data files that are normally text.
!*.json
!*.jsonc
!*.yaml
!*.yml
!*.toml
!*.ini
!*.cfg
!*.conf
!*.env.example
!*.properties
!*.xml
!*.sql

# Program source and scripts.
!*.sh
!*.bash
!*.zsh
!*.fish
!*.ps1
!*.bat
!*.cmd
!*.py
!*.pyw
!*.ipynb
!*.js
!*.jsx
!*.mjs
!*.cjs
!*.ts
!*.tsx
!*.go
!*.rs
!*.c
!*.h
!*.cpp
!*.cxx
!*.cc
!*.hpp
!*.hxx
!*.java
!*.kt
!*.kts
!*.scala
!*.cs
!*.php
!*.rb
!*.pl
!*.pm
!*.r
!*.R
!*.lua
!*.swift
!*.m
!*.mm
!*.html
!*.htm
!*.css
!*.scss
!*.sass
!*.less
!*.vue
!*.svelte

# Common text-based build and project files without extensions.
!Makefile
!Dockerfile
!Containerfile
!Gemfile
!Rakefile
!Procfile
!go.mod
!go.sum
!Cargo.toml
!Cargo.lock
!package.json
!package-lock.json
!pnpm-lock.yaml
!yarn.lock
!tsconfig.json
